define function replacementName() returning string {
    initialize string temporaryName
    set temporaryName to "Rex"
    return temporaryName
}

abstract define class Animal {
    public initialize string name
    public abstract define function speak() returning nothing
}

define class Dog inherits Animal {
    private initialize integer age
    public define constructor {string who, integer years} {
        set name to who
        set age to years
    }
    public define function speak() returning nothing {
        say "Dog Noise"
    }
    public define function introduce(string updatedName) returning nothing {
        say name
        set name to updatedName
    }
}

Initialize Dog pike with ("Pike", 1)
call speak() from pike
say name of pike
call introduce(replacementName()) from pike
say name of pike
