// Demonstration of the custom language
initialize x int
set x to 5

cout << x
set x to x + 5
say x

if (x > 5) {
    say "x is greater than 5"
} else {
    say "x is not greater than 5"
}

if x is equal to 10 {
    say "ten"
} otherwise {
    say "not ten"
}

while (x < 13) {
    x = x + 1
}
say x

repeat 2 times {
    subtract 1 from x
}
say x

multiply 2 to x
say x

divide x by 2
say x

for (int i = 0; i < 3; i++) {
    say i
}

initialize first string
set first to "hello"
initialize second string
set second to first
say second
set second to "world"
say second
